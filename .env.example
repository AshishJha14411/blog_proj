# Root .env.example — used by docker-compose.yml only.
# Copy to .env in this same directory (repo root) and fill in real values.
#
# Note: backend and frontend also have their own .env.example files for when
# you run them outside compose. In compose, backend loads backend/.env via
# `env_file:` on top of what's set here.

# ----- Postgres (compose "db" service) -----
POSTGRES_USER=test_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quill_dev

# ----- Backend secrets forwarded into the container by compose -----
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
GOOGLE_API_KEY=your-gemini-api-key
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong
