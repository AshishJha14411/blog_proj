# backend/.env.example — copy to backend/.env and fill in real values.
# NEVER commit backend/.env (it's already in .gitignore).

# ----- Environment -----
# Set to "production" on live hosts. Anything else is treated as dev, which
# flips cookie flags (secure=False, samesite=lax) and turns on SQL echo.
ENVIRONMENT=development

# ----- Database -----
# Local docker-compose: postgresql://test_user:test_password@db:5432/test_db
# Local bare metal:     postgresql://test_user:test_password@localhost:5432/quill_dev
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/quill_dev

# ----- Redis (rate limiter + cache; UPGRADE_PLAN Phase 1) -----
# Local docker-compose: redis://redis:6379/0
# Local bare metal:     redis://localhost:6379/0
# Production:           managed Redis (e.g. Upstash) — set the full rediss:// URL
REDIS_URL=redis://localhost:6379/0

# ----- Secrets (rotate these before any real deploy) -----
SECRET_KEY=change-me-please
JWT_SECRET_KEY=also-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Seed superadmin -----
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ----- Frontend origin (used for CORS + verification/reset links) -----
FRONTEND_URL=http://localhost:3000

# ----- Mailer (SMTP) -----
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Quill and Code"

# ----- Cloudinary (avatar + cover uploads) -----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----- Google OAuth (optional; skip if not enabling Google login) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ----- LLM -----
LLM_PROVIDER=google           # "google" or "openai"
# flash-LITE, not flash. Measured against this project's key, plain
# `gemini-flash-latest` took 43s to its first streaming chunk and 504-ed in
# production, which made support chat look dead and story generation crawl.
# flash-lite returns its first chunk in ~1s.
# NOTE: `gemini-2.5-flash-lite` and `gemini-2.0-flash-lite` 404 — retired for
# new users. The `-latest` alias is the one that resolves.
LLM_MODEL=gemini-flash-lite-latest
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=8192           # a "long" story needs the headroom
LLM_TIMEOUT=120               # seconds; long-form generation legitimately takes minutes
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

# ----- Background tasks -----
# There is NO Celery worker in production; tasks run inline in the web process
# (docs/adr/001-workerless-inline-tasks.md). docker-compose sets this to `true`
# by default so local behaviour matches production. Set it to `false` only to
# exercise the real worker path - and remember that is NOT what production runs.
CELERY_TASK_ALWAYS_EAGER=true

# ----- SMTP bounds -----
# The send runs INLINE inside the signup request, and `task_time_limit` is
# enforced by a Celery worker - of which there is none. Without these, a hung
# mail provider held the request until Cloud Run's 300s timeout fired.
# SMTP_TIMEOUT_SECONDS bounds ONE attempt; SMTP_TOTAL_BUDGET_SECONDS bounds
# every attempt plus backoff, and is the real worst case a user waits.
# See docs/adr/003-inline-smtp-retry.md.
SMTP_TIMEOUT_SECONDS=5
SMTP_TOTAL_BUDGET_SECONDS=12

# ----- Moderation -----
# How many profane words before a story is HELD for human review. Flagging on
# the first hit made length the real filter (7 of 10 real stories tripped it);
# a threshold measures saturation instead. Automated moderation never rejects -
# it only holds. See docs/adr/004-moderation-holds-not-rejects.md.
MODERATION_PROFANITY_THRESHOLD=10

# ----- Test-only helpers -----
# Set E2E_TESTING=true only when running Cypress; it disables rate limits
# and auto-promotes signup usernames containing "creator" to the creator role.
# E2E_TESTING=true
