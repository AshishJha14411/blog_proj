# backend/.env.example — copy to backend/.env and fill in real values.
# NEVER commit backend/.env (it's already in .gitignore).

# ----- Environment -----
# Set to "production" on live hosts. Anything else is treated as dev, which
# flips cookie flags (secure=False, samesite=lax) and turns on SQL echo.
ENVIRONMENT=development

# ----- Database -----
# Local docker-compose: postgresql://test_user:test_password@db:5432/test_db
# Local bare metal:     postgresql://test_user:test_password@localhost:5432/quill_dev
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/quill_dev

# ----- Secrets (rotate these before any real deploy) -----
SECRET_KEY=change-me-please
JWT_SECRET_KEY=also-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Seed superadmin -----
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ----- Frontend origin (used for CORS + verification/reset links) -----
FRONTEND_URL=http://localhost:3000

# ----- Mailer (SMTP) -----
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Quill and Code

# ----- Cloudinary (avatar + cover uploads) -----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----- Google OAuth (optional; skip if not enabling Google login) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ----- LLM -----
LLM_PROVIDER=google           # "google" or "openai"
LLM_MODEL=gemini-pro-2.5
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

# ----- Test-only helpers -----
# Set E2E_TESTING=true only when running Cypress; it disables rate limits
# and auto-promotes signup usernames containing "creator" to the creator role.
# E2E_TESTING=true
